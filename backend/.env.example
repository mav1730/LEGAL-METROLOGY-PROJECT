FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATA_DIR=./data
HOST=127.0.0.1
PORT=5000
# DEMO_MODE is not read by the app. Use POST /api/scan/sample for built-in samples.
DEMO_MODE=1
# regex | ner | hybrid. Hybrid keeps regex and fills misses from the local NER model.
EXTRACTOR_MODE=hybrid
